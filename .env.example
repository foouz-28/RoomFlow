# ============================================================
#  Example Environment File
#  Copy this file to ".env" and fill in your real values.
# ============================================================

MONGO_URI=your_mongodb_connection_string_here
PORT=3000
JWT_SECRET=your_secret_key_here

# Default admin (used by the seed script)
ADMIN_EMAIL=admin@studyroom.com
ADMIN_PASSWORD=Admin12345

# Public base URL of the app (used inside QR codes)
APP_URL=http://localhost:3000

# Email notifications (optional). Leave empty to disable real sending.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=RoomFlow <no-reply@roomflow.com>
